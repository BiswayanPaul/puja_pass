# Copy to .env and fill in.
# Used by the app at runtime. On Supabase, use the pooled (port 6543) URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/puja_pass?schema=public"
# Used by the Prisma CLI (migrate, studio) and the seed. On Supabase, use the
# session-mode (port 5432) URL. Locally it can equal DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/puja_pass?schema=public"

# Auth.js: encrypts sign-in tokens (`openssl rand -base64 32`). Required.
AUTH_SECRET=""
# Optional "Continue with Google": OAuth client from Google Cloud Console, with
# redirect URI <site>/api/auth/callback/google.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Signs booking links and pass QR codes (`openssl rand -base64 32`).
# Changing it invalidates every link and QR code already sent.
BOOKING_SECRET=""
# Bearer token for /api/cron/notifications, which retries unsent messages.
CRON_SECRET=""

# Email. Configure ONE provider; SMTP wins if both are set. With neither,
# development only logs emails to the terminal.
# a) SMTP, e.g. Gmail: free, ~500 recipients/day, sent from that account.
#    SMTP_PASS is a Google App password (needs 2-Step Verification).
SMTP_USER=""
SMTP_PASS=""
# SMTP_HOST="smtp.gmail.com"   # defaults
# SMTP_PORT="465"
# b) Resend: needs a verified domain before it can email customers.
RESEND_API_KEY=""
# Sender. For Gmail it must be the SMTP_USER address.
EMAIL_FROM="PujaPass <you@example.com>"
# Optional, for testing: send every email to this inbox instead.
EMAIL_REDIRECT_TO=""

# WhatsApp Cloud API (not used yet: the business account needs verification).
WHATSAPP_ACCESS_TOKEN=""
# Copy to .env and fill in.
# Used by the app at runtime. On Supabase, use the pooled (port 6543) URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/puja_pass?schema=public"
# Used by the Prisma CLI (migrate, studio) and the seed. On Supabase, use the
# session-mode (port 5432) URL. Locally it can equal DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/puja_pass?schema=public"
